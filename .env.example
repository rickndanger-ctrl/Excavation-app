# Copy this file to .env and fill in your Supabase project values.
# Get these from: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Enable only after semantic_package_publications from supabase-schema.sql is deployed.
# The app fails visibly if enabled against an incomplete remote schema.
VITE_SEMANTIC_PUBLICATIONS_ENABLED=false
