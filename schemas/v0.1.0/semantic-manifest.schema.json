{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civil-plan-factory.local/schemas/v0.1.0/semantic-manifest.schema.json",
  "title": "Excavation Field Map Semantic Adapter",
  "type": "object",
  "required": ["schema_version", "canonical_model_version", "id", "projectName", "disclaimer", "authoringContract", "customAuthoring", "geometryOriginReceipt", "plan", "phases", "layers", "objects", "areas", "linearFeatures", "surfaces", "utilities", "calibrationPoints", "unavailable", "provenance"],
  "properties": {
    "schema_version": {"const": "excavation-field-map.jobsite-package/v0.1.0"},
    "authoringContract": {
      "type": ["object", "null"],
      "required": ["mode", "canonical_authority", "deliverable_origin", "reference_material_policy"],
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "custom_semantic_design"},
        "canonical_authority": {"const": "semantic_model"},
        "deliverable_origin": {"const": "generated_from_canonical_model"},
        "reference_material_policy": {"const": "context_and_conventions_only"}
      }
    },
    "customAuthoring": {"type": ["object", "null"]},
    "geometryOriginReceipt": {
      "type": ["object", "null"],
      "required": ["schema_version", "origin", "recipe_sha256", "reference_context_phase_ids", "authored_feature_count", "authored_geometry_membership_sha256"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "civil-plan-factory.geometry-origin-receipt/v0.1.0"},
        "origin": {"const": "registered_semantic_recipe"},
        "recipe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_context_phase_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "authored_feature_count": {"type": "integer", "minimum": 1},
        "authored_geometry_membership_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "objects": {"type": "array"},
    "areas": {"type": "array"},
    "linearFeatures": {"type": "array"},
    "utilities": {"type": "array"},
    "surfaces": {"type": "array"},
    "calibrationPoints": {"type": "array"},
    "unavailable": {"type": "array", "items": {"type": "object", "required": ["system", "reason", "provenance_status"]}}
  }
}
